@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sh:   <http://www.w3.org/ns/shacl#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix con:  <https://sharetrait.org/concept/> .
@prefix shape: <https://sharetrait.org/shape/skos/> .
@base <https://sharetrait.org/shape/skos/> .

# ──────────────────────────────────────────────
# ShareTrait SKOS SHACL Shapes
# Validates the controlled vocabularies defined in sharetrait-skos.ttl.
# ──────────────────────────────────────────────

# ═══════════════════════════════════════════════
# Generic ConceptScheme shape
# ═══════════════════════════════════════════════

shape:ConceptSchemeShape a sh:NodeShape ;
    sh:targetClass skos:ConceptScheme ;
    sh:nodeKind sh:IRI ;
    rdfs:label "ConceptScheme shape"@en ;
    rdfs:comment "Every SKOS ConceptScheme must have a label and a comment."@en ;

    sh:property [
        sh:path rdfs:label ;
        sh:minCount 1 ;
        sh:datatype rdf:langString ;
        sh:name "label" ;
        sh:message "A ConceptScheme must have at least one rdfs:label." ;
    ] ;
    sh:property [
        sh:path rdfs:comment ;
        sh:minCount 1 ;
        sh:datatype rdf:langString ;
        sh:name "comment" ;
        sh:message "A ConceptScheme must have at least one rdfs:comment." ;
    ] .

# ═══════════════════════════════════════════════
# Generic Concept shape
# ═══════════════════════════════════════════════

shape:ConceptShape a sh:NodeShape ;
    sh:targetClass skos:Concept ;
    sh:nodeKind sh:IRI ;
    rdfs:label "Concept shape"@en ;
    rdfs:comment "Every SKOS Concept must belong to a scheme, have a prefLabel, and a definition."@en ;

    sh:property [
        sh:path skos:inScheme ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class skos:ConceptScheme ;
        sh:nodeKind sh:IRI ;
        sh:name "in scheme" ;
        sh:message "A Concept must belong to exactly one ConceptScheme via skos:inScheme." ;
    ] ;
    sh:property [
        sh:path skos:prefLabel ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype rdf:langString ;
        sh:name "preferred label" ;
        sh:message "A Concept must have exactly one skos:prefLabel." ;
    ] ;
    sh:property [
        sh:path skos:definition ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:datatype rdf:langString ;
        sh:name "definition" ;
        sh:message "A Concept must have exactly one skos:definition." ;
    ] .

# ═══════════════════════════════════════════════
# Per-scheme membership shapes
# Validate that each concept belongs to the correct scheme.
# ═══════════════════════════════════════════════

# --- Trait Type ---

shape:TraitTypeConceptShape a sh:NodeShape ;
    sh:targetNode con:Development, con:Fecundity, con:MetabolicRate ;
    rdfs:label "Trait type concept shape"@en ;
    sh:property [
        sh:path skos:inScheme ;
        sh:hasValue con:TraitTypeScheme ;
        sh:name "trait type scheme membership" ;
        sh:message "Trait type concepts must belong to con:TraitTypeScheme." ;
    ] .

# --- Trait Category ---

shape:TraitCategoryConceptShape a sh:NodeShape ;
    sh:targetNode con:Functional ;
    rdfs:label "Trait category concept shape"@en ;
    sh:property [
        sh:path skos:inScheme ;
        sh:hasValue con:TraitCategoryScheme ;
        sh:name "trait category scheme membership" ;
        sh:message "Trait category concepts must belong to con:TraitCategoryScheme." ;
    ] .


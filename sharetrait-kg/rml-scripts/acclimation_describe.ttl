@base <https://sharetrait.org/> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix vocab: <https://sharetrait.org/vocab/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<#MeasurementAcclimationMap>
    rml:logicalSource [
        rml:source "../../tables/table_values_v04/acclimation-describe.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;

    rr:subjectMap [
        rr:template "measurement/{measurement_pk}"
    ] ;

    rr:predicateObjectMap [
        rr:predicate vocab:hasAcclimation ;
        rr:objectMap [
            rr:template "acclimation/{acclimation_pk}"
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate vocab:hasSpecificationDate ;
        rr:objectMap [
            rml:reference "specification_date" ;
            rr:datatype xsd:string ;
            rr:termType rr:Literal
        ] ;
        rr:condition "specification_date != ''"
    ] .

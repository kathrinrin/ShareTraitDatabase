@base <https://sharetrait.org/> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix vocab: <https://sharetrait.org/vocab/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .


<#DatasetMap>
    rml:logicalSource [
        rml:source "../../tables/table_values_v04/dataset.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;

    rr:subjectMap [
        rr:template "dataset/{dataset_pk}" ;
        rr:class vocab:Dataset
    ] ;

    rr:predicateObjectMap [
        rr:predicate vocab:hasTitle ;
        rr:objectMap [
            rml:reference "title_dataset" ;
            rr:datatype xsd:string ;
            rr:termType rr:Literal
        ] ;
        rr:condition "title_dataset != '' AND title_dataset != 'NA'"
    ] ;

    rr:predicateObjectMap [
        rr:predicate vocab:hasDOI ;
        rr:objectMap [
            rml:reference "doi_dataset" ;
            rr:datatype xsd:anyURI ;
            rr:termType rr:Literal
        ] ;
        rr:condition "doi_dataset != '' AND doi_dataset != 'NA'"
    ] ;

    rr:predicateObjectMap [
        rr:predicate vocab:hasShareTraitDatasetID ;
        rr:objectMap [
            rml:reference "sharetrait_datasetid" ;
            rr:datatype xsd:string ;
            rr:termType rr:Literal
        ] ;
        rr:condition "sharetrait_datasetid != '' AND sharetrait_datasetid != 'NA'"
    ] ;

    rr:predicateObjectMap [
        rr:predicate vocab:hasReferenceType ;
        rr:objectMap [
            rr:parentTriplesMap <#ConceptLookup> ;
            rr:joinCondition [
                rr:child "reference_type" ;
                rr:parent "csv_value"
            ]
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate vocab:hasDatasetType ;
        rr:objectMap [
            rml:reference "dataset_type" ;
            rr:datatype xsd:string ;
            rr:termType rr:Literal
        ] ;
        rr:condition "dataset_type != '' AND dataset_type != 'NA'"
    ] ;

    rr:predicateObjectMap [
        rr:predicate vocab:hasPublisher ;
        rr:objectMap [
            rml:reference "dataset_publisher" ;
            rr:datatype xsd:string ;
            rr:termType rr:Literal
        ] ;
        rr:condition "dataset_publisher != '' AND dataset_publisher != 'NA'"
    ] ;

    rr:predicateObjectMap [
        rr:predicate vocab:hasYearPublication ;
        rr:objectMap [
            rml:reference "year_publication" ;
            rr:datatype xsd:gYear ;
            rr:termType rr:Literal
        ] ;
        rr:condition "year_publication != '' AND year_publication != 'NA'"
    ] ;

    rr:predicateObjectMap [
        rr:predicate vocab:hasDateContribution ;
        rr:objectMap [
            rml:reference "date_contribution" ;
            rr:datatype xsd:date ;
            rr:termType rr:Literal
        ] ;
        rr:condition "date_contribution != '' AND date_contribution != 'NA'"
    ] ;

    rr:predicateObjectMap [
        rr:predicate vocab:hasDatasetTrait ;
        rr:objectMap [
            rr:parentTriplesMap <#ConceptLookup> ;
            rr:joinCondition [
                rr:child "dataset_trait" ;
                rr:parent "csv_value"
            ]
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate vocab:hasDatasetComment ;
        rr:objectMap [
            rml:reference "dataset_comment" ;
            rr:datatype xsd:string ;
            rr:termType rr:Literal
        ] ;
        rr:condition "dataset_comment != '' AND dataset_comment != 'NA'"
    ] ;

    rr:predicateObjectMap [
        rr:predicate vocab:hasReferenceComment ;
        rr:objectMap [
            rml:reference "comments_reference" ;
            rr:datatype xsd:string ;
            rr:termType rr:Literal
        ] ;
        rr:condition "comments_reference != '' AND comments_reference != 'NA'"
    ] .

<#ConceptLookup>
    rml:logicalSource [
        rml:source "concept_mapping.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;
    rr:subjectMap [
        rr:template "https://sharetrait.org/concept/{concept_id}" ;
        rr:termType rr:IRI
    ] .
@base <https://sharetrait.org/> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix vocab: <https://sharetrait.org/vocab/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix fnml: <http://semweb.mmlab.be/ns/fnml#> .
@prefix fno: <https://w3id.org/function/ontology#> .
@prefix grel: <http://users.ugent.be/~bjdmeest/function/grel.ttl#> .

<#MeasurementMap>
    rml:logicalSource [
        rml:source "../../tables/table_values_v04/measurement.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;

    rr:subjectMap [
        rr:template "measurement/{measurement_pk}" ;
        rr:class vocab:Measurement
    ] ;

    rr:predicateObjectMap [
        rr:predicate vocab:hasIndividual ;
        rr:objectMap [
            rr:template "individual/{individual_pk}"
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate vocab:hasTrait ;
        rr:objectMap [
            rr:template "trait/{trait_pk}"
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate vocab:hasTraitType ;
        rr:objectMap [
            fnml:functionValue [
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant grel:string_replace ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate grel:valueParameter ;
                    rr:objectMap [ rr:template "https://sharetrait.org/concept/{trait_type}" ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate grel:p_string_find ;
                    rr:objectMap [ rr:constant "%20" ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate grel:p_string_replace ;
                    rr:objectMap [ rr:constant "_" ]
                ]
            ] ;
            rr:termType rr:IRI
        ] ;
        rr:condition "trait_type != ''"
    ] ;

    rr:predicateObjectMap [
        rr:predicate vocab:hasTraitValue ;
        rr:objectMap [
            rml:reference "trait_value" ;
            rr:datatype xsd:decimal ;
            rr:termType rr:Literal
        ] ;
        rr:condition "trait_value != ''"
    ] ;

    rr:predicateObjectMap [
        rr:predicate vocab:hasTraitUnit ;
        rr:objectMap [
            rml:reference "trait_unit" ;
            rr:datatype xsd:string ;
            rr:termType rr:Literal
        ] ;
        rr:condition "trait_unit != ''"
    ] ;

    rr:predicateObjectMap [
        rr:predicate vocab:hasTraitErrorEstimate ;
        rr:objectMap [
            rml:reference "trait_error_estimate" ;
            rr:datatype xsd:string ;
            rr:termType rr:Literal
        ] ;
        rr:condition "trait_error_estimate != ''"
    ] ;

    rr:predicateObjectMap [
        rr:predicate vocab:hasTraitErrorType ;
        rr:objectMap [
            rml:reference "trait_error_type" ;
            rr:datatype xsd:string ;
            rr:termType rr:Literal
        ] ;
        rr:condition "trait_error_type != ''"
    ] ;

    rr:predicateObjectMap [
        rr:predicate vocab:hasTraitConverted ;
        rr:objectMap [
            rml:reference "trait_converted" ;
            rr:datatype xsd:string ;
            rr:termType rr:Literal
        ] ;
        rr:condition "trait_converted != ''"
    ] ;

    rr:predicateObjectMap [
        rr:predicate vocab:hasIndividualDevelopmentalStage ;
        rr:objectMap [
            rml:reference "individual_developmental_stage" ;
            rr:datatype xsd:string ;
            rr:termType rr:Literal
        ] ;
        rr:condition "individual_developmental_stage != ''"
    ] ;

    rr:predicateObjectMap [
        rr:predicate vocab:hasFreshMass ;
        rr:objectMap [
            rml:reference "fresh_mass" ;
            rr:datatype xsd:decimal ;
            rr:termType rr:Literal
        ] ;
        rr:condition "fresh_mass != ''"
    ] ;

    rr:predicateObjectMap [
        rr:predicate vocab:hasFreshMassUnit ;
        rr:objectMap [
            rml:reference "fresh_mass_unit" ;
            rr:datatype xsd:string ;
            rr:termType rr:Literal
        ] ;
        rr:condition "fresh_mass_unit != ''"
    ] ;

    rr:predicateObjectMap [
        rr:predicate vocab:hasSampleSize ;
        rr:objectMap [
            rml:reference "sample_size" ;
            rr:datatype xsd:string ;
            rr:termType rr:Literal
        ] ;
        rr:condition "sample_size != ''"
    ] ;

    rr:predicateObjectMap [
        rr:predicate vocab:hasSizeValue ;
        rr:objectMap [
            rml:reference "size_value" ;
            rr:datatype xsd:decimal ;
            rr:termType rr:Literal
        ] ;
        rr:condition "size_value != ''"
    ] ;

    rr:predicateObjectMap [
        rr:predicate vocab:hasSizeUnits ;
        rr:objectMap [
            rml:reference "size_units" ;
            rr:datatype xsd:string ;
            rr:termType rr:Literal
        ] ;
        rr:condition "size_units != ''"
    ] ;

    rr:predicateObjectMap [
        rr:predicate vocab:hasSizeType ;
        rr:objectMap [
            rml:reference "size_type" ;
            rr:datatype xsd:string ;
            rr:termType rr:Literal
        ] ;
        rr:condition "size_type != ''"
    ] ;

    rr:predicateObjectMap [
        rr:predicate vocab:hasLifeStageGeneral ;
        rr:objectMap [
            rml:reference "life_stage_general" ;
            rr:datatype xsd:string ;
            rr:termType rr:Literal
        ] ;
        rr:condition "life_stage_general != ''"
    ] ;

    rr:predicateObjectMap [
        rr:predicate vocab:hasLifeStageSpecific ;
        rr:objectMap [
            rml:reference "life_stage_specific" ;
            rr:datatype xsd:string ;
            rr:termType rr:Literal
        ] ;
        rr:condition "life_stage_specific != ''"
    ] ;

    rr:predicateObjectMap [
        rr:predicate vocab:hasTraitComment ;
        rr:objectMap [
            rml:reference "comment_trait" ;
            rr:datatype xsd:string ;
            rr:termType rr:Literal
        ] ;
        rr:condition "comment_trait != ''"
    ] ;

    rr:predicateObjectMap [
        rr:predicate vocab:hasMeasureDate ;
        rr:objectMap [
            rml:reference "measure_date" ;
            rr:datatype xsd:string ;
            rr:termType rr:Literal
        ] ;
        rr:condition "measure_date != ''"
    ] ;

    rr:predicateObjectMap [
        rr:predicate vocab:hasFecundityTemporalUnit ;
        rr:objectMap [
            rml:reference "fecundity_temporal_unit" ;
            rr:datatype xsd:string ;
            rr:termType rr:Literal
        ] ;
        rr:condition "fecundity_temporal_unit != ''"
    ] ;

    rr:predicateObjectMap [
        rr:predicate vocab:hasReproductiveStage ;
        rr:objectMap [
            rml:reference "reproductive_stage" ;
            rr:datatype xsd:string ;
            rr:termType rr:Literal
        ] ;
        rr:condition "reproductive_stage != ''"
    ] ;

    rr:predicateObjectMap [
        rr:predicate vocab:hasExperimentLocation ;
        rr:objectMap [
            rml:reference "experiment_location" ;
            rr:datatype xsd:string ;
            rr:termType rr:Literal
        ] ;
        rr:condition "experiment_location != ''"
    ] ;

    rr:predicateObjectMap [
        rr:predicate vocab:hasExperimentalConditionsComment ;
        rr:objectMap [
            rml:reference "comments_experimental_conditions" ;
            rr:datatype xsd:string ;
            rr:termType rr:Literal
        ] ;
        rr:condition "comments_experimental_conditions != ''"
    ] ;

    rr:predicateObjectMap [
        rr:predicate vocab:hasLifestageSpecificInitial ;
        rr:objectMap [
            rml:reference "lifestage_specific_initial" ;
            rr:datatype xsd:string ;
            rr:termType rr:Literal
        ] ;
        rr:condition "lifestage_specific_initial != ''"
    ] ;

    rr:predicateObjectMap [
        rr:predicate vocab:hasLifestageSpecificFinal ;
        rr:objectMap [
            rml:reference "lifestage_specific_final" ;
            rr:datatype xsd:string ;
            rr:termType rr:Literal
        ] ;
        rr:condition "lifestage_specific_final != ''"
    ] ;

    rr:predicateObjectMap [
        rr:predicate vocab:hasSizeValueInitial ;
        rr:objectMap [
            rml:reference "size_value_initial" ;
            rr:datatype xsd:decimal ;
            rr:termType rr:Literal
        ] ;
        rr:condition "size_value_initial != ''"
    ] ;

    rr:predicateObjectMap [
        rr:predicate vocab:hasSizeValueFinal ;
        rr:objectMap [
            rml:reference "size_value_final" ;
            rr:datatype xsd:decimal ;
            rr:termType rr:Literal
        ] ;
        rr:condition "size_value_final != ''"
    ] .

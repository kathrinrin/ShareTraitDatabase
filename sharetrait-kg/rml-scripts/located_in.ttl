@base <https://sharetrait.org/> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix vocab: <https://sharetrait.org/vocab/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .

<#PlaceSiteMap>
    rml:logicalSource [
        rml:source "../../tables/table_values_v04/located_in.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;

    rr:subjectMap [
        rr:template "place/{place_pk}"
    ] ;

    rr:predicateObjectMap [
        rr:predicate vocab:locatedIn ;
        rr:objectMap [
            rr:template "site/{site_pk}"
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate vocab:hasLocationDescription ;
        rr:objectMap [
            rml:reference "location_description" ;
            rr:datatype xsd:string ;
            rr:termType rr:Literal
        ] ;
        rr:condition "location_description != ''"
    ] ;

    rr:predicateObjectMap [
        rr:predicate vocab:hasLocationCheck ;
        rr:objectMap [
            rml:reference "location_check" ;
            rr:datatype xsd:string ;
            rr:termType rr:Literal
        ] ;
        rr:condition "location_check != ''"
    ] .

<#SiteLatLonMap>
    rml:logicalSource [
        rml:source "../../tables/table_values_v04/located_in.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;

    rr:subjectMap [
        rr:template "site/{site_pk}"
    ] ;

    rr:predicateObjectMap [
        rr:predicate vocab:hasLatitude ;
        rr:objectMap [
            rml:reference "latitude" ;
            rr:datatype xsd:decimal ;
            rr:termType rr:Literal
        ] ;
        rr:condition "latitude != ''"
    ] ;

    rr:predicateObjectMap [
        rr:predicate vocab:hasLongitude ;
        rr:objectMap [
            rml:reference "longitude" ;
            rr:datatype xsd:decimal ;
            rr:termType rr:Literal
        ] ;
        rr:condition "longitude != ''"
    ] .

<#SiteGeoMap>
    rml:logicalSource [
        rml:source "../../tables/table_values_v04/located_in.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;

    rr:subjectMap [
        rr:template "site/{site_pk}"
    ] ;

    rr:predicateObjectMap [
        rr:predicate geo:hasGeometry ;
        rr:objectMap [
            rr:template "site/{site_pk}/geometry"
        ]
    ] .

<#SiteGeometryMap>
    rml:logicalSource [
        rml:source "../../tables/table_values_v04/located_in.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;

    rr:subjectMap [
        rr:template "site/{site_pk}/geometry" ;
        rr:class geo:Geometry
    ] ;

    rr:predicateObjectMap [
        rr:predicate geo:asWKT ;
        rr:objectMap [
            rr:template "POINT({longitude} {latitude})" ;
            rr:termType rr:Literal ;
            rr:datatype geo:wktLiteral
        ] ;
        rr:condition "latitude != '' && longitude != '' && latitude != 'NA' && longitude != 'NA'"
    ] .

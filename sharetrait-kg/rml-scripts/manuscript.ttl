@base <https://sharetrait.org/> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix vocab: <https://sharetrait.org/vocab/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<#ManuscriptMap>
    rml:logicalSource [
        rml:source "../../tables/table_values_v04/manuscript.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;

    rr:subjectMap [
        rr:template "manuscript/{manuscript_pk}" ;
        rr:class vocab:Manuscript
    ] ;

    rr:predicateObjectMap [
        rr:predicate vocab:hasTitle ;
        rr:objectMap [
            rml:reference "title_manuscript" ;
            rr:termType rr:Literal
        ] ;
        rr:condition "title_manuscript != ''"
    ] ;

    rr:predicateObjectMap [
        rr:predicate vocab:hasDOI ;
        rr:objectMap [
            rml:reference "doi_manuscript" ;
            rr:termType rr:Literal
        ] ;
        rr:condition "doi_manuscript != ''"
    ] ;

    rr:predicateObjectMap [
        rr:predicate vocab:hasType ;
        rr:objectMap [
            rml:reference "type_manuscript" ;
            rr:termType rr:Literal
        ] ;
        rr:condition "type_manuscript != ''"
    ] ;

    rr:predicateObjectMap [
        rr:predicate vocab:hasPublisher ;
        rr:objectMap [
            rml:reference "manuscript_publisher" ;
            rr:termType rr:Literal
        ] ;
        rr:condition "manuscript_publisher != ''"
    ] ;

    rr:predicateObjectMap [
        rr:predicate vocab:hasCitation ;
        rr:objectMap [
            rml:reference "manuscript_citation" ;
            rr:termType rr:Literal
        ] ;
        rr:condition "manuscript_citation != ''"
    ] ;

    rr:predicateObjectMap [
        rr:predicate vocab:hasYearPublication ;
        rr:objectMap [
            rml:reference "year_publication" ;
            rr:datatype xsd:gYear ;
            rr:termType rr:Literal
        ] ;
        rr:condition "year_publication != ''"
    ] ;

    rr:predicateObjectMap [
        rr:predicate rdfs:comment ;
        rr:objectMap [
            rml:reference "manuscript_comment" ;
            rr:termType rr:Literal
        ] ;
        rr:condition "manuscript_comment != ''"
    ] .

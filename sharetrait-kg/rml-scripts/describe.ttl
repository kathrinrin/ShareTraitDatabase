@base <https://sharetrait.org/> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix vocab: <https://sharetrait.org/vocab/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<#DatasetPopulationMap>
    rml:logicalSource [
        rml:source "../../tables/table_values_v04/describe.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;

    rr:subjectMap [
        rr:template "dataset/{dataset_pk}"
    ] ;

    rr:predicateObjectMap [
        rr:predicate vocab:describesPopulation ;
        rr:objectMap [
            rr:template "population/{population_pk}"
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate vocab:hasDateDescribe ;
        rr:objectMap [
            rml:reference "date_describe" ;
            rr:datatype xsd:string ;
            rr:termType rr:Literal
        ] ;
        rr:condition "date_describe != ''"
    ] ;

    rr:predicateObjectMap [
        rr:predicate vocab:hasDateIso ;
        rr:objectMap [
            rml:reference "date_iso" ;
            rr:datatype xsd:date ;
            rr:termType rr:Literal
        ] ;
        rr:condition "date_iso != ''"
    ] ;

    rr:predicateObjectMap [
        rr:predicate vocab:hasYear ;
        rr:objectMap [
            rml:reference "year" ;
            rr:datatype xsd:gYear ;
            rr:termType rr:Literal
        ] ;
        rr:condition "year != ''"
    ] .

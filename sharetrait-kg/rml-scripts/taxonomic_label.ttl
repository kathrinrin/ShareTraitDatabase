@base <https://sharetrait.org/> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix vocab: <https://sharetrait.org/vocab/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<#TaxonomicLabelMap>
    rml:logicalSource [
        rml:source "../../tables/table_values_v04/taxonomic_label.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;

    rr:subjectMap [
        rr:template "taxonomy/{taxonomy_pk}"
    ] ;

    rr:predicateObjectMap [
        rr:predicate vocab:labelsPopulation ;
        rr:objectMap [
            rr:template "population/{population_pk}"
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate vocab:hasNameDate ;
        rr:objectMap [
            rml:reference "name_date" ;
            rr:datatype xsd:string ;
            rr:termType rr:Literal
        ] ;
        rr:condition "name_date != ''"
    ] ;

    rr:predicateObjectMap [
        rr:predicate vocab:hasReferenceSource ;
        rr:objectMap [
            rml:reference "reference_source" ;
            rr:datatype xsd:string ;
            rr:termType rr:Literal
        ] ;
        rr:condition "reference_source != ''"
    ] ;

    rr:predicateObjectMap [
        rr:predicate vocab:hasVersionTaxa ;
        rr:objectMap [
            rml:reference "version_taxa" ;
            rr:datatype xsd:string ;
            rr:termType rr:Literal
        ] ;
        rr:condition "version_taxa != ''"
    ] .

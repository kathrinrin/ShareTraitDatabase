@base <https://sharetrait.org/> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix vocab: <https://sharetrait.org/vocab/> .

<#MeasurementTechniqueMap>
    rml:logicalSource [
        rml:source "../../tables/table_values_v04/chamber-describe.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;

    rr:subjectMap [
        rr:template "measurement/{measurement_pk}" ;
        rr:class vocab:Measurement
    ] ;

    rr:predicateObjectMap [
        rr:predicate vocab:usesTechnique ;
        rr:objectMap [
            rr:template "technique/{technique_pk}"
        ]
    ] .

<#TechniqueTypeMap>
    rml:logicalSource [
        rml:source "../../tables/table_values_v04/chamber-describe.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;

    rr:subjectMap [
        rr:template "technique/{technique_pk}" ;
        rr:class vocab:Technique
    ] .
@base <https://sharetrait.org/> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix vocab: <https://sharetrait.org/vocab/> .

<#IndividualMap>
    rml:logicalSource [
        rml:source "../../tables/table_values_v04/individual.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;

    rr:subjectMap [
        rr:template "individual/{individual_pk}" ;
        rr:class vocab:Individual
    ] ;

    rr:predicateObjectMap [
        rr:predicate vocab:hasRepresentativeStage ;
        rr:objectMap [
            rml:reference "representative_stage" ;
            rr:termType rr:Literal
        ] ;
        rr:condition "representative_stage != ''"
    ] ;

    rr:predicateObjectMap [
        rr:predicate vocab:hasSex ;
        rr:objectMap [
            rml:reference "sex" ;
            rr:termType rr:Literal
        ] ;
        rr:condition "sex != ''"
    ] ;

    rr:predicateObjectMap [
        rr:predicate vocab:hasIndividualType ;
        rr:objectMap [
            rml:reference "individual_type" ;
            rr:termType rr:Literal
        ] ;
        rr:condition "individual_type != ''"
    ] ;

    rr:predicateObjectMap [
        rr:predicate vocab:hasMatingMethod ;
        rr:objectMap [
            rml:reference "mating_method" ;
            rr:termType rr:Literal
        ] ;
        rr:condition "mating_method != ''"
    ] ;

    rr:predicateObjectMap [
        rr:predicate vocab:hasMethodType ;
        rr:objectMap [
            rml:reference "method_type" ;
            rr:termType rr:Literal
        ] ;
        rr:condition "method_type != ''"
    ] ;

    rr:predicateObjectMap [
        rr:predicate vocab:hasStrategyOfProtection ;
        rr:objectMap [
            rml:reference "strategy_of_protection" ;
            rr:termType rr:Literal
        ] ;
        rr:condition "strategy_of_protection != ''"
    ] ;

    rr:predicateObjectMap [
        rr:predicate vocab:hasDescription ;
        rr:objectMap [
            rml:reference "description_individual" ;
            rr:termType rr:Literal
        ] ;
        rr:condition "description_individual != ''"
    ] ;

    rr:predicateObjectMap [
        rr:predicate vocab:hasComment ;
        rr:objectMap [
            rml:reference "comment" ;
            rr:termType rr:Literal
        ] ;
        rr:condition "comment != ''"
    ] ;

    rr:predicateObjectMap [
        rr:predicate vocab:hasParentSizeType ;
        rr:objectMap [
            rml:reference "parent_size_type" ;
            rr:termType rr:Literal
        ] ;
        rr:condition "parent_size_type != ''"
    ] ;

    rr:predicateObjectMap [
        rr:predicate vocab:hasParentSizeUnits ;
        rr:objectMap [
            rml:reference "parent_size_units" ;
            rr:termType rr:Literal
        ] ;
        rr:condition "parent_size_units != ''"
    ] ;

    rr:predicateObjectMap [
        rr:predicate vocab:hasParentalSizeValue ;
        rr:objectMap [
            rml:reference "parental_size_value" ;
            rr:termType rr:Literal
        ] ;
        rr:condition "parental_size_value != ''"
    ] ;

    rr:predicateObjectMap [
        rr:predicate vocab:hasParentAge ;
        rr:objectMap [
            rml:reference "parent_age" ;
            rr:termType rr:Literal
        ] ;
        rr:condition "parent_age != ''"
    ] ;

    rr:predicateObjectMap [
        rr:predicate vocab:hasParentAgeUnits ;
        rr:objectMap [
            rml:reference "parent_age_units" ;
            rr:termType rr:Literal
        ] ;
        rr:condition "parent_age_units != ''"
    ] ;

    rr:predicateObjectMap [
        rr:predicate vocab:hasOffspringDevelopmentalStage ;
        rr:objectMap [
            rml:reference "offspring_developmental_stage" ;
            rr:termType rr:Literal
        ] ;
        rr:condition "offspring_developmental_stage != ''"
    ] ;

    rr:predicateObjectMap [
        rr:predicate vocab:hasOffspringSizeType ;
        rr:objectMap [
            rml:reference "offspring_size_type" ;
            rr:termType rr:Literal
        ] ;
        rr:condition "offspring_size_type != ''"
    ] ;

    rr:predicateObjectMap [
        rr:predicate vocab:hasOffspringSizeUnits ;
        rr:objectMap [
            rml:reference "offspring_size_units" ;
            rr:termType rr:Literal
        ] ;
        rr:condition "offspring_size_units != ''"
    ] ;

    rr:predicateObjectMap [
        rr:predicate vocab:hasOffspringSizeValue ;
        rr:objectMap [
            rml:reference "offspring_size_value" ;
            rr:termType rr:Literal
        ] ;
        rr:condition "offspring_size_value != ''"
    ] .

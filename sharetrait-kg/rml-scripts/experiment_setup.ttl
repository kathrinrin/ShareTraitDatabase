@base <https://sharetrait.org/> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix vocab: <https://sharetrait.org/vocab/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .


<#MeasurementConditionMap>
    rml:logicalSource [
        rml:source "../../tables/table_values_v04/experiment_setup.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;

    rr:subjectMap [
        rr:template "measurement/{measurement_pk}"
    ] ;

    rr:predicateObjectMap [
        rr:predicate vocab:hasCondition ;
        rr:objectMap [
            rr:template "condition/{condition_pk}"
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate vocab:hasConditionLabel ;
        rr:objectMap [
            rr:parentTriplesMap <#ConceptLookup> ;
            rr:joinCondition [
                rr:child "condition_label" ;
                rr:parent "csv_value"
            ]
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate vocab:hasSetupDate ;
        rr:objectMap [
            rml:reference "setup_date" ;
            rr:datatype xsd:string ;
            rr:termType rr:Literal
        ] ;
        rr:condition "setup_date != ''"
    ] ;

    rr:predicateObjectMap [
        rr:predicate vocab:hasExperimentLocation ;
        rr:objectMap [
            rr:parentTriplesMap <#ConceptLookup> ;
            rr:joinCondition [
                rr:child "experiment_location" ;
                rr:parent "csv_value"
            ]
        ]
    ] .

<#ConceptLookup>
    rml:logicalSource [
        rml:source "concept_mapping.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;
    rr:subjectMap [
        rr:template "https://sharetrait.org/concept/{concept_id}" ;
        rr:termType rr:IRI
    ] .

<#ConditionLabelMap>
    rml:logicalSource [
        rml:source "../../tables/table_values_v04/experiment_setup.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;

    rr:subjectMap [
        rr:template "condition/{condition_pk}"
    ] ;

    rr:predicateObjectMap [
        rr:predicate vocab:hasConditionLabel ;
        rr:objectMap [
            rml:reference "condition_label" ;
            rr:datatype xsd:string ;
            rr:termType rr:Literal
        ] ;
        rr:condition "condition_label != ''"
    ] .

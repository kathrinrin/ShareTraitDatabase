@base <https://sharetrait.org/> .
@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix rml: <http://semweb.mmlab.be/ns/rml#> .
@prefix ql: <http://semweb.mmlab.be/ns/ql#> .
@prefix vocab: <https://sharetrait.org/vocab/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix fnml: <http://semweb.mmlab.be/ns/fnml#> .
@prefix fno: <https://w3id.org/function/ontology#> .
@prefix grel: <http://users.ugent.be/~bjdmeest/function/grel.ttl#> .

<#MeasurementConditionMap>
    rml:logicalSource [
        rml:source "../../tables/table_values_v04/experiment_setup.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;

    rr:subjectMap [
        rr:template "measurement/{measurement_pk}"
    ] ;

    rr:predicateObjectMap [
        rr:predicate vocab:hasCondition ;
        rr:objectMap [
            rr:template "condition/{condition_pk}"
        ]
    ] ;

    rr:predicateObjectMap [
        rr:predicate vocab:hasConditionLabel ;
        rr:objectMap [
            fnml:functionValue [
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant grel:string_replace ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate grel:valueParameter ;
                    rr:objectMap [ rr:template "https://sharetrait.org/concept/{condition_label}" ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate grel:p_string_find ;
                    rr:objectMap [ rr:constant "%20" ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate grel:p_string_replace ;
                    rr:objectMap [ rr:constant "_" ]
                ]
            ] ;
            rr:termType rr:IRI
        ] ;
        rr:condition "condition_label != ''"
    ] ;

    rr:predicateObjectMap [
        rr:predicate vocab:hasSetupDate ;
        rr:objectMap [
            rml:reference "setup_date" ;
            rr:datatype xsd:string ;
            rr:termType rr:Literal
        ] ;
        rr:condition "setup_date != ''"
    ] ;

    rr:predicateObjectMap [
        rr:predicate vocab:hasExperimentLocation ;
        rr:objectMap [
            fnml:functionValue [
                rr:predicateObjectMap [
                    rr:predicate fno:executes ;
                    rr:objectMap [ rr:constant grel:string_replace ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate grel:valueParameter ;
                    rr:objectMap [ rr:template "https://sharetrait.org/concept/{experiment_location}" ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate grel:p_string_find ;
                    rr:objectMap [ rr:constant "%20" ]
                ] ;
                rr:predicateObjectMap [
                    rr:predicate grel:p_string_replace ;
                    rr:objectMap [ rr:constant "_" ]
                ]
            ] ;
            rr:termType rr:IRI
        ] ;
        rr:condition "experiment_location != ''"
    ] .

<#ConditionLabelMap>
    rml:logicalSource [
        rml:source "../../tables/table_values_v04/experiment_setup.csv" ;
        rml:referenceFormulation ql:CSV
    ] ;

    rr:subjectMap [
        rr:template "condition/{condition_pk}"
    ] ;

    rr:predicateObjectMap [
        rr:predicate vocab:hasConditionLabel ;
        rr:objectMap [
            rml:reference "condition_label" ;
            rr:datatype xsd:string ;
            rr:termType rr:Literal
        ] ;
        rr:condition "condition_label != ''"
    ] .

PREFIX vocab: <https://sharetrait.org/vocab/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

# ============================================================
# Query 6
# Published datasets that describe fecundity traits:
# how many populations, which species, dataset DOI and
# dataset_trait field.
# ============================================================

SELECT
  ?dataset_pk
  (COUNT(DISTINCT ?population) AS ?population_count)
  (GROUP_CONCAT(DISTINCT ?species_reported ; separator=",") AS ?species_list)
  (SAMPLE(?scientific_name_val) AS ?scientific_name)
  ?doi_dataset
  ?dataset_trait

WHERE {
  ?dataset a vocab:Dataset ;
    vocab:hasDatasetTrait ?dataset_trait_iri .

  FILTER(?dataset_trait_iri = <https://sharetrait.org/concept/Fecundity>)
  ?dataset_trait_iri skos:prefLabel ?dataset_trait_raw .
  BIND(STR(?dataset_trait_raw) AS ?dataset_trait)

  ?dataset vocab:describesPopulation ?population .

  ?taxonomy a vocab:Taxonomy ;
    vocab:labelsPopulation ?population .

  BIND(STRAFTER(STR(?dataset), "dataset/") AS ?dataset_pk)

  OPTIONAL { ?dataset    vocab:hasDOI      ?doi_dataset }
  OPTIONAL { ?population vocab:hasSpeciesReported  ?species_reported }
  OPTIONAL { ?taxonomy   vocab:hasScientificName   ?scientific_name_val }
}
GROUP BY ?dataset_pk ?doi_dataset ?dataset_trait

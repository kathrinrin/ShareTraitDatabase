PREFIX vocab: <https://sharetrait.org/vocab/>

# ============================================================
# Query 3
# Which datasets describe fecundity traits?
# Returns dataset PKs, DOIs, repositories, and related
# manuscript DOIs (if any).
# ============================================================

SELECT DISTINCT
  ?dataset_pk
  ?doi_dataset
  ?dataset_publisher
  ?doi_manuscript

WHERE {
  ?measurement a vocab:Measurement ;
    vocab:hasTraitType      ?trait_type ;
    vocab:hasIndividual ?individual .

  FILTER(?trait_type = <https://sharetrait.org/concept/fecundity>)

  ?population a vocab:Population ;
    vocab:containsIndividual ?individual .

  ?dataset a vocab:Dataset ;
    vocab:describesPopulation ?population .

  BIND(STRAFTER(STR(?dataset), "dataset/") AS ?dataset_pk)

  OPTIONAL { ?dataset    vocab:hasDOI       ?doi_dataset }
  OPTIONAL { ?dataset    vocab:hasPublisher ?dataset_publisher }
  OPTIONAL {
    ?dataset vocab:hasManuscript ?manuscript .
    OPTIONAL { ?manuscript vocab:hasDOI ?doi_manuscript }
  }
}

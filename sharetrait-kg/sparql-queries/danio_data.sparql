PREFIX vocab: <https://sharetrait.org/vocab/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

# danio_data: datasets and trait types for genus Danio
# Replicates the SQL export "danio_data"

SELECT
  ?dataset_pk
  ?species_reported
  ?trait_type
  (COUNT(?trait_value) AS ?count_trait_value)
  ?trait_unit

WHERE {
  ?taxonomy a vocab:Taxonomy ;
    vocab:hasGenusName ?genus_name .

  FILTER(?genus_name = "Danio")

  ?taxonomy vocab:labelsPopulation ?population .

  ?population a vocab:Population .

  ?dataset a vocab:Dataset ;
    vocab:describesPopulation ?population .

  ?population vocab:containsIndividual ?individual .

  ?individual a vocab:Individual .

  ?measurement a vocab:Measurement ;
    vocab:hasIndividual ?individual ;
    vocab:hasTraitType  ?trait_type_iri .

  ?trait_type_iri skos:prefLabel ?trait_type_raw .
  BIND(STR(?trait_type_raw) AS ?trait_type)
  BIND(STRAFTER(STR(?dataset), "dataset/") AS ?dataset_pk)

  OPTIONAL { ?measurement vocab:hasTraitValue ?trait_value }
  OPTIONAL { ?measurement vocab:hasTraitUnit  ?trait_unit }
  OPTIONAL { ?population  vocab:hasSpeciesReported ?species_reported }
}
GROUP BY ?dataset_pk ?species_reported ?trait_type ?trait_unit

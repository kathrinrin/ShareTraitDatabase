PREFIX vocab: <https://sharetrait.org/vocab/>
PREFIX xsd:   <http://www.w3.org/2001/XMLSchema#>

# ============================================================
# Query 8
# Maximum development trait value per population of genus Rana,
# across all datasets.
# ============================================================

SELECT
  ?dataset_pk
  ?title_dataset
  ?doi_dataset
  ?sharetrait_datasetid
  ?population_pk
  ?scientific_name
  ?genus_name
  ?trait_type
  (MAX(xsd:decimal(?trait_value)) AS ?max_trait_value)
  ?trait_unit

WHERE {
  ?taxonomy a vocab:Taxonomy ;
    vocab:hasGenusName ?genus_name .

  FILTER(?genus_name = "Rana")

  ?taxonomy vocab:labelsPopulation ?population .

  ?population a vocab:Population ;
    vocab:containsIndividual ?individual .

  ?dataset a vocab:Dataset ;
    vocab:describesPopulation ?population .

  ?measurement a vocab:Measurement ;
    vocab:hasIndividual ?individual ;
    vocab:hasTraitType      ?trait_type ;
    vocab:hasTraitValue     ?trait_value .

  FILTER(?trait_type = "development")

  BIND(STRAFTER(STR(?dataset),    "dataset/")    AS ?dataset_pk)
  BIND(STRAFTER(STR(?population), "population/") AS ?population_pk)

  OPTIONAL { ?dataset    vocab:hasTitle        ?title_dataset }
  OPTIONAL { ?dataset    vocab:hasDOI          ?doi_dataset }
  OPTIONAL { ?dataset    vocab:hasShareTraitDatasetID ?sharetrait_datasetid }
  OPTIONAL { ?taxonomy   vocab:hasScientificName      ?scientific_name }
  OPTIONAL { ?measurement vocab:hasTraitUnit          ?trait_unit }
}
GROUP BY
  ?dataset_pk ?title_dataset ?doi_dataset ?sharetrait_datasetid
  ?population_pk ?scientific_name ?genus_name ?trait_type ?trait_unit

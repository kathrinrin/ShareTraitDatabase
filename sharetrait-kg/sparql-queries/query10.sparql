PREFIX vocab: <https://sharetrait.org/vocab/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>

# ============================================================
# Query 10
# Effect of test temperature on body size:
# development trait values with size and test condition
# temperature for genus Chalcolestes.
# ============================================================

SELECT
  ?genus_name
  ?trait_type
  ?trait_value
  ?trait_unit
  ?size_value_final
  ?size_units
  ?size_type
  ?temperature
  ?condition_label

WHERE {
  ?taxonomy a vocab:Taxonomy ;
    vocab:hasGenusName ?genus_name .

  FILTER(?genus_name = "Chalcolestes")

  ?taxonomy vocab:labelsPopulation ?population .

  ?population a vocab:Population ;
    vocab:containsIndividual ?individual .

  ?measurement a vocab:Measurement ;
    vocab:hasIndividual ?individual ;
    vocab:hasTraitType      ?trait_type_iri ;
    vocab:hasCondition       ?condition .

  FILTER(?trait_type_iri = <https://sharetrait.org/concept/Development>)
  ?trait_type_iri skos:prefLabel ?trait_type_raw .
  BIND(STR(?trait_type_raw) AS ?trait_type)

  ?condition vocab:hasConditionLabel ?condition_label ;
             vocab:hasTemperature    ?temperature .

  FILTER(?condition_label = "test")

  OPTIONAL { ?measurement vocab:hasTraitValue     ?trait_value }
  OPTIONAL { ?measurement vocab:hasTraitUnit      ?trait_unit }
  OPTIONAL { ?measurement vocab:hasSizeValueFinal ?size_value_final }
  OPTIONAL { ?measurement vocab:hasSizeUnits       ?size_units }
  OPTIONAL { ?measurement vocab:hasSizeType        ?size_type }
}

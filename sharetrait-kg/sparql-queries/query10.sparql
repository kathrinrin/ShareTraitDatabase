PREFIX vocab: <https://sharetrait.org/vocab/>

# ============================================================
# Query 10
# Effect of test temperature on body size:
# development trait values with size and test condition
# temperature for genus Chalcolestes.
# ============================================================

SELECT
  ?genus_name
  ?trait_type
  ?trait_value
  ?trait_unit
  ?size_value_final
  ?size_units
  ?size_type
  ?temperature
  ?condition_label

WHERE {
  ?taxonomy a vocab:Taxonomy ;
    vocab:hasGenus_name ?genus_name .

  FILTER(?genus_name = "Chalcolestes")

  ?taxonomy vocab:labelsPopulation ?population .

  ?population a vocab:Population ;
    vocab:containsIndividual ?individual .

  ?measurement a vocab:Measurement ;
    vocab:measuresIndividual ?individual ;
    vocab:hasTrait_type      ?trait_type ;
    vocab:hasTrait_value     ?trait_value ;
    vocab:hasCondition       ?condition ;
    vocab:hasConditionLabel  ?condition_label .

  FILTER(?trait_type      = "development")
  FILTER(?condition_label = "test")

  ?condition vocab:hasTemperature ?temperature .

  OPTIONAL { ?measurement vocab:hasTrait_unit      ?trait_unit }
  OPTIONAL { ?measurement vocab:hasSize_value_final ?size_value_final }
  OPTIONAL { ?measurement vocab:hasSize_units       ?size_units }
  OPTIONAL { ?measurement vocab:hasSize_type        ?size_type }
}

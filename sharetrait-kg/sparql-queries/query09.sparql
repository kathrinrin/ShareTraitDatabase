PREFIX vocab: <https://sharetrait.org/vocab/>

# ============================================================
# Query 9
# All test-condition temperatures used for development trait
# measurements of genus Rana, with grouped trait values.
# ============================================================

# --- 9a: grouped trait values per test temperature ---

SELECT
  ?genus_name
  ?trait_type
  (GROUP_CONCAT(?trait_value ; separator=",") AS ?trait_values)
  ?trait_unit
  ?temperature
  ?condition_label

WHERE {
  ?taxonomy a vocab:Taxonomy ;
    vocab:hasGenusName ?genus_name .

  FILTER(?genus_name = "Rana")

  ?taxonomy vocab:labelsPopulation ?population .

  ?population a vocab:Population ;
    vocab:containsIndividual ?individual .

  ?measurement a vocab:Measurement ;
    vocab:hasIndividual ?individual ;
    vocab:hasTraitType      ?trait_type ;
    vocab:hasTraitValue     ?trait_value ;
    vocab:hasCondition       ?condition .

  FILTER(?trait_type   = "development")

  ?condition vocab:hasConditionLabel ?condition_label ;
             vocab:hasTemperature    ?temperature .

  FILTER(?condition_label = "test")

  OPTIONAL { ?measurement vocab:hasTraitUnit ?trait_unit }
}
GROUP BY ?genus_name ?trait_type ?trait_unit ?temperature ?condition_label



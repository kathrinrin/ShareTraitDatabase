@prefix : <http://sharetrait.org/ontologies/traits#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://sharetrait.org/ontologies/traits#> .

<http://sharetrait.org/ontologies/traits> rdf:type owl:Ontology ;
                                           owl:imports <http://sharetrait.org/ontologies/traits/data-sample> ;
                                           rdfs:comment "Complete ShareTrait Protege tutorial ontology - the end state after Steps 1-8 plus the Optional Extra (two probe classes). Use this file as the reference solution; diff it against sharetrait-ontology-starter.ttl to see exactly which axioms participants add during the live session. The ABox (named individuals: 4 organisms, 1 respirometer, 6 trait measurements) lives in sharetrait-data-sample.ttl and is pulled in via owl:imports."@en ;
                                           rdfs:label "ShareTrait Tutorial Ontology - Complete"@en ;
                                           owl:versionInfo "1.2.0" .

#################################################################
#    Object Properties
#################################################################

###  http://sharetrait.org/ontologies/traits#hasComponent
:hasComponent rdf:type owl:ObjectProperty ;
              owl:inverseOf :isComponentOf .


###  http://sharetrait.org/ontologies/traits#hasLifeStage
:hasLifeStage rdf:type owl:ObjectProperty ,
                       owl:FunctionalProperty ;
              rdfs:domain :TraitMeasurement ;
              rdfs:range :LifeStage .


###  http://sharetrait.org/ontologies/traits#hasRealm
:hasRealm rdf:type owl:ObjectProperty ,
                   owl:FunctionalProperty ;
          rdfs:domain :Organism ;
          rdfs:range :Realm .


###  http://sharetrait.org/ontologies/traits#hasTemperatureRange
:hasTemperatureRange rdf:type owl:ObjectProperty ,
                              owl:FunctionalProperty ;
                     rdfs:domain :TraitMeasurement ;
                     rdfs:range :TemperatureRange .


###  http://sharetrait.org/ontologies/traits#isComponentOf
:isComponentOf rdf:type owl:ObjectProperty .


###  http://sharetrait.org/ontologies/traits#isInstrumentOf
:isInstrumentOf rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf :isComponentOf ;
                owl:inverseOf :usedInstrument .


###  http://sharetrait.org/ontologies/traits#isOrganismOf
:isOrganismOf rdf:type owl:ObjectProperty ;
              rdfs:subPropertyOf :isComponentOf ;
              owl:inverseOf :measuredOnOrganism .


###  http://sharetrait.org/ontologies/traits#isTraitTypeOf
:isTraitTypeOf rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf :isComponentOf ;
               owl:inverseOf :measuresTraitType .


###  http://sharetrait.org/ontologies/traits#measuredOnOrganism
:measuredOnOrganism rdf:type owl:ObjectProperty ;
                    rdfs:subPropertyOf :hasComponent ;
                    rdf:type owl:FunctionalProperty ;
                    rdfs:domain :TraitMeasurement ;
                    rdfs:range :Organism .


###  http://sharetrait.org/ontologies/traits#measuresTraitType
:measuresTraitType rdf:type owl:ObjectProperty ;
                   rdfs:subPropertyOf :hasComponent ;
                   rdfs:domain :TraitMeasurement ;
                   rdfs:range :TraitType .


###  http://sharetrait.org/ontologies/traits#usedInstrument
:usedInstrument rdf:type owl:ObjectProperty ;
                rdfs:subPropertyOf :hasComponent ;
                rdf:type owl:FunctionalProperty ;
                rdfs:domain :TraitMeasurement ;
                rdfs:range :Instrument .


#################################################################
#    Data properties
#################################################################

###  http://sharetrait.org/ontologies/traits#hasScientificName
:hasScientificName rdf:type owl:DatatypeProperty ;
                   rdfs:domain :Organism ;
                   rdfs:range xsd:string .


###  http://sharetrait.org/ontologies/traits#hasTraitValue
:hasTraitValue rdf:type owl:DatatypeProperty ;
               rdfs:domain :TraitMeasurement ;
               rdfs:range xsd:decimal .


#################################################################
#    Classes
#################################################################

###  http://sharetrait.org/ontologies/traits#Adult
:Adult rdf:type owl:Class ;
       rdfs:subClassOf :LifeStage .


###  http://sharetrait.org/ontologies/traits#Amphibian
:Amphibian rdf:type owl:Class ;
           rdfs:subClassOf :Organism .


###  http://sharetrait.org/ontologies/traits#AphidiusDevelopmentStudy
:AphidiusDevelopmentStudy rdf:type owl:Class ;
                          rdfs:subClassOf :TraitMeasurement ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty :hasTemperatureRange ;
                                            owl:someValuesFrom :Cold
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty :measuredOnOrganism ;
                                            owl:someValuesFrom :ParasitoidWasp
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty :measuresTraitType ;
                                            owl:someValuesFrom :DevelopmentTrait
                                          ] ,
                                          [ rdf:type owl:Restriction ;
                                            owl:onProperty :measuresTraitType ;
                                            owl:allValuesFrom :DevelopmentTrait
                                          ] ;
                          owl:disjointWith :MetabolicRateRespirometryStudy .


###  http://sharetrait.org/ontologies/traits#Aquatic
:Aquatic rdf:type owl:Class ;
         rdfs:subClassOf :Realm ;
         owl:disjointWith :Terrestrial .


###  http://sharetrait.org/ontologies/traits#Cold
:Cold rdf:type owl:Class ;
      rdfs:subClassOf :TemperatureRange .


###  http://sharetrait.org/ontologies/traits#ColdExposureMeasurement
:ColdExposureMeasurement rdf:type owl:Class ;
                         owl:equivalentClass [ owl:intersectionOf ( :TraitMeasurement
                                                                    [ rdf:type owl:Restriction ;
                                                                      owl:onProperty :hasTemperatureRange ;
                                                                      owl:someValuesFrom :Cold
                                                                    ]
                                                                  ) ;
                                               rdf:type owl:Class
                                             ] ;
                         rdfs:subClassOf :TraitMeasurement .


###  http://sharetrait.org/ontologies/traits#DevelopmentTrait
:DevelopmentTrait rdf:type owl:Class ;
                  rdfs:subClassOf :TraitType .


###  http://sharetrait.org/ontologies/traits#Embryo
:Embryo rdf:type owl:Class ;
        rdfs:subClassOf :LifeStage .


###  http://sharetrait.org/ontologies/traits#FecundityTrait
:FecundityTrait rdf:type owl:Class ;
                rdfs:subClassOf :TraitType .


###  http://sharetrait.org/ontologies/traits#Fish
:Fish rdf:type owl:Class ;
      rdfs:subClassOf :Organism ,
                      [ rdf:type owl:Restriction ;
                        owl:onProperty :hasRealm ;
                        owl:someValuesFrom :Aquatic
                      ] .


###  http://sharetrait.org/ontologies/traits#FruitFly
:FruitFly rdf:type owl:Class ;
          rdfs:subClassOf :Insect ;
          owl:disjointWith :ParasitoidWasp .


###  http://sharetrait.org/ontologies/traits#Hot
:Hot rdf:type owl:Class ;
     rdfs:subClassOf :TemperatureRange .


###  http://sharetrait.org/ontologies/traits#InconsistentDevelopmentMetabolism
# Commented out because it's optional 
# :InconsistentDevelopmentMetabolism rdf:type owl:Class ;
#                                    rdfs:subClassOf :DevelopmentTrait ,
#                                                    :MetabolicRateTrait ;
#                                    rdfs:comment "Probe class: intentionally unsatisfiable because :DevelopmentTrait and :MetabolicRateTrait are declared disjoint."@en .


###  http://sharetrait.org/ontologies/traits#Insect
:Insect rdf:type owl:Class ;
        rdfs:subClassOf :Organism .


###  http://sharetrait.org/ontologies/traits#InsectTraitMeasurement
:InsectTraitMeasurement rdf:type owl:Class ;
                        owl:equivalentClass [ owl:intersectionOf ( :TraitMeasurement
                                                                   [ rdf:type owl:Restriction ;
                                                                     owl:onProperty :measuredOnOrganism ;
                                                                     owl:someValuesFrom :Insect
                                                                   ]
                                                                 ) ;
                                              rdf:type owl:Class
                                            ] ;
                        rdfs:subClassOf :TraitMeasurement .


###  http://sharetrait.org/ontologies/traits#Instrument
:Instrument rdf:type owl:Class .


###  http://sharetrait.org/ontologies/traits#Juvenile
:Juvenile rdf:type owl:Class ;
          rdfs:subClassOf :LifeStage .


###  http://sharetrait.org/ontologies/traits#JuvenileFishMeasurement
:JuvenileFishMeasurement rdf:type owl:Class ;
                         owl:equivalentClass [ owl:intersectionOf ( :TraitMeasurement
                                                                    [ rdf:type owl:Restriction ;
                                                                      owl:onProperty :hasLifeStage ;
                                                                      owl:someValuesFrom :Juvenile
                                                                    ]
                                                                    [ rdf:type owl:Restriction ;
                                                                      owl:onProperty :measuredOnOrganism ;
                                                                      owl:someValuesFrom :Fish
                                                                    ]
                                                                  ) ;
                                               rdf:type owl:Class
                                             ] ;
                         rdfs:subClassOf :TraitMeasurement .


###  http://sharetrait.org/ontologies/traits#LifeStage
:LifeStage rdf:type owl:Class ;
           owl:equivalentClass [ rdf:type owl:Class ;
                                 owl:unionOf ( :Adult
                                               :Embryo
                                               :Juvenile
                                             )
                               ] .


###  http://sharetrait.org/ontologies/traits#MetabolicRateRespirometryStudy
:MetabolicRateRespirometryStudy rdf:type owl:Class ;
                                rdfs:subClassOf :TraitMeasurement ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty :measuresTraitType ;
                                                  owl:someValuesFrom :MetabolicRateTrait
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty :usedInstrument ;
                                                  owl:someValuesFrom :Respirometer
                                                ] ,
                                                [ rdf:type owl:Restriction ;
                                                  owl:onProperty :measuresTraitType ;
                                                  owl:allValuesFrom :MetabolicRateTrait
                                                ] .


###  http://sharetrait.org/ontologies/traits#MetabolicRateTrait
:MetabolicRateTrait rdf:type owl:Class ;
                    rdfs:subClassOf :TraitType .


###  http://sharetrait.org/ontologies/traits#Organism
:Organism rdf:type owl:Class .


###  http://sharetrait.org/ontologies/traits#ParasitoidWasp
:ParasitoidWasp rdf:type owl:Class ;
                rdfs:subClassOf :Insect .


###  http://sharetrait.org/ontologies/traits#Realm
:Realm rdf:type owl:Class ;
       owl:equivalentClass [ rdf:type owl:Class ;
                             owl:unionOf ( :Aquatic
                                           :Terrestrial
                                         )
                           ] .


###  http://sharetrait.org/ontologies/traits#Respirometer
:Respirometer rdf:type owl:Class ;
              rdfs:subClassOf :Instrument .


###  http://sharetrait.org/ontologies/traits#RespirometryMeasurement
:RespirometryMeasurement rdf:type owl:Class ;
                         owl:equivalentClass [ owl:intersectionOf ( :TraitMeasurement
                                                                    [ rdf:type owl:Restriction ;
                                                                      owl:onProperty :usedInstrument ;
                                                                      owl:someValuesFrom :Respirometer
                                                                    ]
                                                                  ) ;
                                               rdf:type owl:Class
                                             ] ;
                         rdfs:subClassOf :TraitMeasurement .


###  http://sharetrait.org/ontologies/traits#SpangledPerch
:SpangledPerch rdf:type owl:Class ;
               rdfs:subClassOf :Fish ;
               rdfs:label "Spangled perch"@en ;
               rdfs:comment "Leiopotherapon unicolor - a small Australian freshwater fish (family Terapontidae)."@en .


###  http://sharetrait.org/ontologies/traits#TemperatureRange
:TemperatureRange rdf:type owl:Class ;
                  owl:equivalentClass [ rdf:type owl:Class ;
                                        owl:unionOf ( :Cold
                                                      :Hot
                                                      :Warm
                                                    )
                                      ] .


###  http://sharetrait.org/ontologies/traits#Terrestrial
:Terrestrial rdf:type owl:Class ;
             rdfs:subClassOf :Realm .


###  http://sharetrait.org/ontologies/traits#TraitMeasurement
:TraitMeasurement rdf:type owl:Class .


###  http://sharetrait.org/ontologies/traits#TraitType
:TraitType rdf:type owl:Class .


###  http://sharetrait.org/ontologies/traits#UnclosedTraitMeasurement
# Commented out because it's optional 
# :UnclosedTraitMeasurement rdf:type owl:Class ;
#                           rdfs:subClassOf :TraitMeasurement ,
#                                           [ rdf:type owl:Restriction ;
#                                             owl:onProperty :measuredOnOrganism ;
#                                             owl:someValuesFrom :Insect
#                                           ] ,
#                                           [ rdf:type owl:Restriction ;
#                                             owl:onProperty :measuresTraitType ;
#                                             owl:someValuesFrom :DevelopmentTrait
#                                           ] ;
#                           rdfs:comment "Probe class: no closure (owl:allValuesFrom) axiom on :measuresTraitType, so the reasoner cannot conclude this class is equivalent to :InsectTraitMeasurement."@en .


###  http://sharetrait.org/ontologies/traits#Warm
:Warm rdf:type owl:Class ;
      rdfs:subClassOf :TemperatureRange .


#################################################################
#    General axioms
#################################################################

[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :Adult
                :Embryo
                :Juvenile
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :Amphibian
                :Fish
                :Insect
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :Cold
                :Hot
                :Warm
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :DevelopmentTrait
                :FecundityTrait
                :MetabolicRateTrait
              )
] .


[ rdf:type owl:AllDisjointClasses ;
  owl:members ( :Instrument
                :Organism
                :TraitMeasurement
                :TraitType
              )
] .



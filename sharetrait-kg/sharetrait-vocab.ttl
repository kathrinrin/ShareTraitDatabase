    rdfs:domain vocab:Condition ;
    rdfs:range xsd:decimal ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> .

vocab:hasDurationGenerations a owl:DatatypeProperty ;
    rdfs:label "has duration generations"@en ;
    rdfs:comment "Number of generations during the condition."@en ;
    rdfs:domain vocab:Condition ;
    rdfs:range xsd:decimal ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> .

vocab:hasMethodCheck a owl:DatatypeProperty ;
    rdfs:label "has method check"@en ;
    rdfs:comment "Internal metadata indicating the type of condition label (e.g., 'test', 'maintenance', 'acclimation')."@en ;
    rdfs:domain vocab:Condition ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> .

# ---------------------------------------------------------------------------
# Experiment setup (junction) properties
# ---------------------------------------------------------------------------

vocab:hasConditionLabel a owl:DatatypeProperty ;
    rdfs:label "has condition label"@en ;
    rdfs:comment "Type of experimental condition: 'test', 'maintenance', or 'acclimation'."@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> .

vocab:hasSetupDate a owl:DatatypeProperty ;
    rdfs:label "has setup date"@en ;
    rdfs:comment "ISO date when the experimental setup was conducted."@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> .

# ---------------------------------------------------------------------------
# Technique (respiratory chamber) properties
# ---------------------------------------------------------------------------

vocab:hasSensorType a owl:DatatypeProperty ;
    rdfs:label "has sensor type"@en ;
    rdfs:comment "Sensor type used to measure oxygen during the experiment (e.g., 'fiber optic-based oxygen analyzer')."@en ;
    rdfs:domain vocab:Technique ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> .

vocab:hasRespirationVolume a owl:DatatypeProperty ;
    rdfs:label "has respiration volume"@en ;
    rdfs:comment "Volume of the empty respirometric chamber."@en ;
    rdfs:domain vocab:Technique ;
    rdfs:range xsd:decimal ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> .

vocab:hasDelayTime a owl:DatatypeProperty ;
    rdfs:label "has delay time"@en ;
    rdfs:comment "Wait (delay) time excluded from closed measurement cycles, also called equilibration period."@en ;
    rdfs:domain vocab:Technique ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> .

vocab:hasRespiratoryChamberMaterial a owl:DatatypeProperty ;
    rdfs:label "has respiratory chamber material"@en ;
    rdfs:comment "Material of the respirometer (e.g., 'glass', 'plastic')."@en ;
    rdfs:domain vocab:Technique ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> .

vocab:hasIncubationTime a owl:DatatypeProperty ;
    rdfs:label "has incubation time"@en ;
    rdfs:comment "Time spent in the respirometry chamber."@en ;
    rdfs:domain vocab:Technique ;
    rdfs:range xsd:decimal ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> .

vocab:hasRespirometryType a owl:DatatypeProperty ;
    rdfs:label "has respirometry type"@en ;
    rdfs:comment "Type of respirometry as defined by the researcher (e.g., 'closed')."@en ;
    rdfs:domain vocab:Technique ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> .

vocab:hasBreathingMode a owl:DatatypeProperty ;
    rdfs:label "has breathing mode"@en ;
    rdfs:comment "Breathing mode based on the respiratory medium (e.g., 'aquatic')."@en ;
    rdfs:domain vocab:Technique ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> .

vocab:hasMetabolicRateType a owl:DatatypeProperty ;
    rdfs:label "has metabolic rate type"@en ;
    rdfs:comment "Type of metabolic rate measured (e.g., 'standard')."@en ;
    rdfs:domain vocab:Technique ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> .

# ---------------------------------------------------------------------------
# Acclimation properties
# ---------------------------------------------------------------------------

vocab:hasMating a owl:DatatypeProperty ;
    rdfs:label "has mating"@en ;
    rdfs:comment "Whether mating was allowed during the acclimation period."@en ;
    rdfs:domain vocab:Acclimation ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> .

vocab:hasChamber a owl:DatatypeProperty ;
    rdfs:label "has chamber"@en ;
    rdfs:comment "Acclimation time after transfer to the respirometry chamber."@en ;
    rdfs:domain vocab:Acclimation ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> .

vocab:hasFastingTime a owl:DatatypeProperty ;
    rdfs:label "has fasting time"@en ;
    rdfs:comment "Duration of animal fasting before placement in the respirometry chamber."@en ;
    rdfs:domain vocab:Acclimation ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> .

vocab:hasSpecificationDate a owl:DatatypeProperty ;
    rdfs:label "has specification date"@en ;
    rdfs:comment "ISO date when the acclimation or chamber specification was conducted."@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> .

# ---------------------------------------------------------------------------
# Describe (Dataset-Population junction) properties
# ---------------------------------------------------------------------------

vocab:hasDateDescribe a owl:DatatypeProperty ;
    rdfs:label "has date describe"@en ;
    rdfs:comment "Date when a population was described."@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> .

vocab:hasDateIso a owl:DatatypeProperty ;
    rdfs:label "has date ISO"@en ;
    rdfs:comment "Standard ISO-formatted date."@en ;
    rdfs:range xsd:date ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> .

vocab:hasYear a owl:DatatypeProperty ;
    rdfs:label "has year"@en ;
    rdfs:comment "Year value."@en ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> .

# =============================================================================
# CONTROLLED VOCABULARIES (as SKOS Concept Schemes)
# =============================================================================

# ---------------------------------------------------------------------------
# Trait Type Scheme
# ---------------------------------------------------------------------------

vocab:TraitTypeScheme a skos:ConceptScheme ;
    rdfs:label "ShareTrait Trait Type Scheme"@en ;
    rdfs:comment "Controlled vocabulary for trait type categories used in ShareTrait."@en .

vocab:Development a skos:Concept ;
    skos:inScheme vocab:TraitTypeScheme ;
    skos:prefLabel "development"@en ;
    skos:definition "Traits related to developmental time and processes."@en .

vocab:Fecundity a skos:Concept ;
    skos:inScheme vocab:TraitTypeScheme ;
    skos:prefLabel "fecundity"@en ;
    skos:definition "Traits related to reproductive output and offspring production."@en .

vocab:MetabolicRate a skos:Concept ;
    skos:inScheme vocab:TraitTypeScheme ;
    skos:prefLabel "metabolic_rate"@en ;
    skos:definition "Traits related to the rate of energy expenditure, typically measured as oxygen consumption or CO2 production."@en .

# ---------------------------------------------------------------------------
# Trait Category Scheme
# ---------------------------------------------------------------------------

vocab:TraitCategoryScheme a skos:ConceptScheme ;
    rdfs:label "ShareTrait Trait Category Scheme"@en ;
    rdfs:comment "Controlled vocabulary for the broad trait category."@en .

vocab:Functional a skos:Concept ;
    skos:inScheme vocab:TraitCategoryScheme ;
    skos:prefLabel "functional"@en ;
    skos:definition "Functional traits that affect organism performance."@en .

# ---------------------------------------------------------------------------
# Condition Label Scheme
# ---------------------------------------------------------------------------

vocab:ConditionLabelScheme a skos:ConceptScheme ;
    rdfs:label "ShareTrait Condition Label Scheme"@en ;
    rdfs:comment "Controlled vocabulary for experimental condition types."@en .

vocab:TestCondition a skos:Concept ;
    skos:inScheme vocab:ConditionLabelScheme ;
    skos:prefLabel "test"@en ;
    skos:definition "Testing condition under which trait measurements are taken."@en .

vocab:MaintenanceCondition a skos:Concept ;
    skos:inScheme vocab:ConditionLabelScheme ;
    skos:prefLabel "maintenance"@en ;
    skos:definition "Maintenance condition under which organisms are kept before experiments."@en .

vocab:AcclimationCondition a skos:Concept ;
    skos:inScheme vocab:ConditionLabelScheme ;
    skos:prefLabel "acclimation"@en ;
    skos:definition "Acclimation condition used to adapt organisms before testing."@en .

# ---------------------------------------------------------------------------
# Population Label Scheme
# ---------------------------------------------------------------------------

vocab:PopulationLabelScheme a skos:ConceptScheme ;
    rdfs:label "ShareTrait Population Label Scheme"@en ;
    rdfs:comment "Controlled vocabulary for population measurement level."@en .

vocab:IndividualMeasure a skos:Concept ;
    skos:inScheme vocab:PopulationLabelScheme ;
    skos:prefLabel "ind_measure"@en ;
    skos:definition "Population providing individual-level measurements."@en .

vocab:PopulationMeasure a skos:Concept ;
    skos:inScheme vocab:PopulationLabelScheme ;
    skos:prefLabel "pop_measure"@en ;
    skos:definition "Population providing population-level aggregate measurements."@en .

# ---------------------------------------------------------------------------
# Reference Type Scheme
# ---------------------------------------------------------------------------

vocab:ReferenceTypeScheme a skos:ConceptScheme ;
    rdfs:label "ShareTrait Reference Type Scheme"@en ;
    rdfs:comment "Controlled vocabulary for dataset reference types."@en .

vocab:PrimaryReference a skos:Concept ;
    skos:inScheme vocab:ReferenceTypeScheme ;
    skos:prefLabel "primary"@en ;
    skos:definition "The primary reference for the data."@en .

vocab:SecondaryReference a skos:Concept ;
    skos:inScheme vocab:ReferenceTypeScheme ;
    skos:prefLabel "secondary"@en ;
    skos:definition "A secondary reference for the data."@en .

# ---------------------------------------------------------------------------
# Individual Type Scheme
# ---------------------------------------------------------------------------

vocab:IndividualTypeScheme a skos:ConceptScheme ;
    rdfs:label "ShareTrait Individual Type Scheme"@en ;
    rdfs:comment "Controlled vocabulary for individual type (parent/offspring)."@en .

vocab:ParentType a skos:Concept ;
    skos:inScheme vocab:IndividualTypeScheme ;
    skos:prefLabel "parent"@en ;
    skos:definition "The individual is a parent in a parent-offspring relationship."@en .

vocab:OffspringType a skos:Concept ;
    skos:inScheme vocab:IndividualTypeScheme ;
    skos:prefLabel "offspring"@en ;
    skos:definition "The individual is an offspring in a parent-offspring relationship."@en .

# ---------------------------------------------------------------------------
# Location Label Scheme
# ---------------------------------------------------------------------------

vocab:LocationLabelScheme a skos:ConceptScheme ;
    rdfs:label "ShareTrait Location Label Scheme"@en ;
    rdfs:comment "Controlled vocabulary for how a place name was obtained."@en .

vocab:CommentBased a skos:Concept ;
    skos:inScheme vocab:LocationLabelScheme ;
    skos:prefLabel "comment-based"@en ;
    skos:definition "Place name obtained from textual comments in the dataset."@en .

vocab:GpsBased a skos:Concept ;
    skos:inScheme vocab:LocationLabelScheme ;
    skos:prefLabel "gps-based"@en ;
    skos:definition "Place name derived from GPS coordinates."@en .

# ---------------------------------------------------------------------------
# Origin Scheme
# ---------------------------------------------------------------------------

vocab:OriginScheme a skos:ConceptScheme ;
    rdfs:label "ShareTrait Origin Scheme"@en ;
    rdfs:comment "Controlled vocabulary for the origin of collected individuals."@en .

vocab:FieldOrigin a skos:Concept ;
    skos:inScheme vocab:OriginScheme ;
    skos:prefLabel "field"@en ;
    skos:definition "Individuals collected from the field."@en .

# ---------------------------------------------------------------------------
# Realm Scheme
# ---------------------------------------------------------------------------

vocab:RealmScheme a skos:ConceptScheme ;
    rdfs:label "ShareTrait Realm Scheme"@en ;
    rdfs:comment "Controlled vocabulary for general ecological realm."@en .

vocab:Terrestrial a skos:Concept ;
    skos:inScheme vocab:RealmScheme ;
    skos:prefLabel "terrestrial"@en ;
    skos:definition "Terrestrial (land-based) realm."@en .

vocab:Aquatic a skos:Concept ;
    skos:inScheme vocab:RealmScheme ;
    skos:prefLabel "aquatic"@en ;
    skos:definition "Aquatic (water-based) realm."@en .

# ---------------------------------------------------------------------------
# Respirometry Type Scheme
# ---------------------------------------------------------------------------

vocab:RespirometryTypeScheme a skos:ConceptScheme ;
    rdfs:label "ShareTrait Respirometry Type Scheme"@en ;
    rdfs:comment "Controlled vocabulary for types of respirometry."@en .

vocab:ClosedRespirometry a skos:Concept ;
    skos:inScheme vocab:RespirometryTypeScheme ;
    skos:prefLabel "closed"@en ;
    skos:definition "Closed-system respirometry."@en .

# ---------------------------------------------------------------------------
# Metabolic Rate Type Scheme
# ---------------------------------------------------------------------------

vocab:MetabolicRateTypeScheme a skos:ConceptScheme ;
    rdfs:label "ShareTrait Metabolic Rate Type Scheme"@en ;
    rdfs:comment "Controlled vocabulary for metabolic rate types."@en .

vocab:StandardMetabolicRate a skos:Concept ;
    skos:inScheme vocab:MetabolicRateTypeScheme ;
    skos:prefLabel "standard"@en ;
    skos:definition "Standard metabolic rate (minimal rate of energy expenditure in a resting, post-absorptive ectotherm)."@en .

# ---------------------------------------------------------------------------
# Breathing Mode Scheme
# ---------------------------------------------------------------------------

vocab:BreathingModeScheme a skos:ConceptScheme ;
    rdfs:label "ShareTrait Breathing Mode Scheme"@en ;
    rdfs:comment "Controlled vocabulary for breathing modes in respirometry."@en .

vocab:AquaticBreathing a skos:Concept ;
    skos:inScheme vocab:BreathingModeScheme ;
    skos:prefLabel "aquatic"@en ;
    skos:definition "Breathing mode using an aquatic respiratory medium."@en .

# =============================================================================
# ENTITY ID PATTERNS (documented as annotations)
# =============================================================================

vocab:Dataset rdfs:comment "A published or contributed dataset containing functional trait measurements. Each dataset is identified by a DOI and a ShareTrait dataset ID, and may be linked to one or more manuscripts."@en ;
    skos:note "Primary key pattern: TRADAT + 3-digit number (e.g., TRADAT001). IRI template: https://sharetrait.org/dataset/{dataset_pk}" .

vocab:Manuscript skos:note "Primary key pattern: TRAMAN + 3-digit number (e.g., TRAMAN001). IRI template: https://sharetrait.org/manuscript/{manuscript_pk}" .

vocab:Population skos:note "Primary key pattern: TRAPOP + 3-digit number (e.g., TRAPOP001). IRI template: https://sharetrait.org/population/{population_pk}" .

vocab:Individual skos:note "Primary key pattern: TRAIN + 6-digit number (e.g., TRAIN000001). IRI template: https://sharetrait.org/individual/{individual_pk}" .

vocab:Measurement skos:note "Primary key pattern: TRAMEA + 6-digit number (e.g., TRAMEA000001). IRI template: https://sharetrait.org/measurement/{measurement_pk}" .

vocab:Trait skos:note "Primary key pattern: TRATRA + 3-digit number (e.g., TRATRA001). IRI template: https://sharetrait.org/trait/{trait_pk}" .

vocab:Taxonomy skos:note "Primary key pattern: TRATAX + 3-digit number (e.g., TRATAX001). IRI template: https://sharetrait.org/taxonomy/{taxonomy_pk}" .

vocab:Site skos:note "Primary key pattern: TRASIT + 3-digit number (e.g., TRASIT001). IRI template: https://sharetrait.org/site/{site_pk}" .

vocab:Place skos:note "Primary key pattern: TRAPLA + 3-digit number (e.g., TRAPLA018). IRI template: https://sharetrait.org/place/{place_pk}" .

vocab:Condition skos:note "Primary key pattern: TRACON + 6-digit number (e.g., TRACON000001). IRI template: https://sharetrait.org/condition/{condition_pk}" .

vocab:Technique skos:note "Primary key pattern: TRATEC + 6-digit number (e.g., TRATEC000001). IRI template: https://sharetrait.org/technique/{technique_pk}" .

vocab:Acclimation skos:note "Primary key pattern: TRAACC + 6-digit number (e.g., TRAACC000001). IRI template: https://sharetrait.org/acclimation/{acclimation_pk}" .

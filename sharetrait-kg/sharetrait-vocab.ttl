@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix vann: <http://purl.org/vocab/vann/> .
@prefix vocab: <https://sharetrait.org/vocab/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@base <https://sharetrait.org/vocab/> .

# =============================================================================
# ShareTrait Vocabulary — Ontology Metadata
# =============================================================================

<https://sharetrait.org/vocab/> a owl:Ontology ;
    dcterms:title "ShareTrait Vocabulary"@en ;
    dcterms:description "Vocabulary for the ShareTrait Database and Knowledge Graph. ShareTrait is a relational database developed for standardising and integrating functional trait datasets across species. It covers organism traits (development, fecundity, metabolic rate), taxonomy, geographic occurrence, experimental conditions, and measurement methodology."@en ;
    dcterms:created "2025-01-01"^^xsd:date ;
    dcterms:modified "2025-07-24"^^xsd:date ;
    owl:versionInfo "1.0.0" ;
    vann:preferredNamespacePrefix "vocab" ;
    vann:preferredNamespaceUri "https://sharetrait.org/vocab/" .

# =============================================================================
# CLASSES
# =============================================================================

# ---------------------------------------------------------------------------
# Source category
# ---------------------------------------------------------------------------

vocab:Dataset a owl:Class ;
    rdfs:label "Dataset"@en ;
    rdfs:comment "A published or contributed dataset containing functional trait measurements. Each dataset is identified by a DOI and a ShareTrait dataset ID, and may be linked to one or more manuscripts."@en ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> ;
    skos:example "TRADAT001" .

vocab:Manuscript a owl:Class ;
    rdfs:label "Manuscript"@en ;
    rdfs:comment "A scientific publication (journal article, data paper, etc.) associated with one or more datasets. Manuscripts provide the scholarly context for the trait data."@en ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> ;
    skos:example "TRAMAN001" .

# ---------------------------------------------------------------------------
# Organism category
# ---------------------------------------------------------------------------

vocab:Population a owl:Class ;
    rdfs:label "Population"@en ;
    rdfs:comment "A group of organisms of the same species observed or collected together. A population may represent individual-level measurements (ind_measure) or population-level aggregates (pop_measure)."@en ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> ;
    skos:example "TRAPOP001" .

vocab:Individual a owl:Class ;
    rdfs:label "Individual"@en ;
    rdfs:comment "A single organism or specimen belonging to a population. Individuals carry attributes such as sex, life stage, type (parent/offspring), and size metrics."@en ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> ;
    skos:example "TRAIN000001" .

vocab:Measurement a owl:Class ;
    rdfs:label "Measurement"@en ;
    rdfs:comment "A single trait measurement observation for an individual, recording the trait value, unit, error estimates, and contextual information such as life stage and body size at time of measurement."@en ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> ;
    skos:example "TRAMEA000001" .

vocab:Trait a owl:Class ;
    rdfs:label "Trait"@en ;
    rdfs:comment "A defined functional trait type (e.g., development time, metabolic rate, fecundity). Each trait has a formal definition, preferred unit, and may have parent-child relationships with other traits."@en ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> ;
    skos:example "TRATRA001" .

# ---------------------------------------------------------------------------
# Taxonomy category
# ---------------------------------------------------------------------------

vocab:Taxonomy a owl:Class ;
    rdfs:label "Taxonomy"@en ;
    rdfs:comment "A reference taxonomy entry providing the full taxonomic classification of a species (phylum through species), linked to an external taxonomic database such as the Catalogue of Life."@en ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> ;
    skos:example "TRATAX001" .

# ---------------------------------------------------------------------------
# Environment / Location category
# ---------------------------------------------------------------------------

vocab:Site a owl:Class ;
    rdfs:label "Site"@en ;
    rdfs:comment "A specific geographic or ecological site where organisms were observed or collected. Sites have attributes for realm (terrestrial, aquatic, etc.), elevation, and depth."@en ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> ;
    skos:example "TRASIT001" .

vocab:Place a owl:Class ;
    rdfs:label "Place"@en ;
    rdfs:comment "A named geographic location (city, region, area) with country and continent information. Places contain one or more sites and may be linked to GeoNames identifiers."@en ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> ;
    skos:example "TRAPLA018" .

# ---------------------------------------------------------------------------
# Method category
# ---------------------------------------------------------------------------

vocab:Condition a owl:Class ;
    rdfs:label "Condition"@en ;
    rdfs:comment "A set of experimental or environmental conditions (temperature, photoperiod, humidity, oxygen, CO2, salinity, pH, food type) under which measurements were taken. Conditions are categorised as test, maintenance, or acclimation."@en ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> ;
    skos:example "TRACON000001" .

vocab:Technique a owl:Class ;
    rdfs:label "Technique"@en ;
    rdfs:comment "A respirometry technique specification describing the equipment and methodology used for metabolic rate measurements, including sensor type, chamber material, respirometry type, and breathing mode."@en ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> ;
    skos:example "TRATEC000001" .

vocab:Acclimation a owl:Class ;
    rdfs:label "Acclimation"@en ;
    rdfs:comment "An acclimation protocol specification describing conditions prior to respirometry measurements, including mating allowance, chamber acclimation time, and fasting duration."@en ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> ;
    skos:example "TRAACC000001" .

# =============================================================================
# OBJECT PROPERTIES (entity-to-entity relationships)
# =============================================================================

# --- Source relationships ---

vocab:hasManuscript a owl:ObjectProperty ;
    rdfs:label "has manuscript"@en ;
    rdfs:comment "Links a dataset to its associated manuscript (via the publication junction)."@en ;
    rdfs:domain vocab:Dataset ;
    rdfs:range vocab:Manuscript ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> .

# --- Organism relationships ---

vocab:describesPopulation a owl:ObjectProperty ;
    rdfs:label "describes population"@en ;
    rdfs:comment "Links a dataset to a population it describes (via the describe junction, which also carries date metadata)."@en ;
    rdfs:domain vocab:Dataset ;
    rdfs:range vocab:Population ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> .

vocab:containsIndividual a owl:ObjectProperty ;
    rdfs:label "contains individual"@en ;
    rdfs:comment "Links a population to an individual organism belonging to it."@en ;
    rdfs:domain vocab:Population ;
    rdfs:range vocab:Individual ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> .

vocab:hasIndividual a owl:ObjectProperty ;
    rdfs:label "has individual"@en ;
    rdfs:comment "Links a measurement to the individual it was taken from."@en ;
    rdfs:domain vocab:Measurement ;
    rdfs:range vocab:Individual ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> .

vocab:hasTrait a owl:ObjectProperty ;
    rdfs:label "has trait"@en ;
    rdfs:comment "Links a measurement to the trait type being measured."@en ;
    rdfs:domain vocab:Measurement ;
    rdfs:range vocab:Trait ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> .

# --- Taxonomy relationships ---

vocab:labelsPopulation a owl:ObjectProperty ;
    rdfs:label "labels population"@en ;
    rdfs:comment "Links a taxonomy entry to a population it taxonomically identifies (via the taxonomic_label junction, which carries date, source, and version metadata)."@en ;
    rdfs:domain vocab:Taxonomy ;
    rdfs:range vocab:Population ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> .

# --- Environment relationships ---

vocab:occurredAt a owl:ObjectProperty ;
    rdfs:label "occurred at"@en ;
    rdfs:comment "Links a population to the site where it was observed or collected (via the occurrence junction, which carries observation dates and origin)."@en ;
    rdfs:domain vocab:Population ;
    rdfs:range vocab:Site ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> .

vocab:locatedIn a owl:ObjectProperty ;
    rdfs:label "located in"@en ;
    rdfs:comment "Links a place to a site it contains, carrying geographic coordinates and location description."@en ;
    rdfs:domain vocab:Place ;
    rdfs:range vocab:Site ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> .

# --- Method relationships ---

vocab:hasCondition a owl:ObjectProperty ;
    rdfs:label "has condition"@en ;
    rdfs:comment "Links a measurement to experimental conditions under which it was performed (via the experiment_setup junction, which carries condition_label, setup_date, and experiment_location)."@en ;
    rdfs:domain vocab:Measurement ;
    rdfs:range vocab:Condition ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> .

vocab:usesTechnique a owl:ObjectProperty ;
    rdfs:label "uses technique"@en ;
    rdfs:comment "Links a measurement to the respirometry technique used (via the chamber_describe junction)."@en ;
    rdfs:domain vocab:Measurement ;
    rdfs:range vocab:Technique ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> .

vocab:hasAcclimation a owl:ObjectProperty ;
    rdfs:label "has acclimation"@en ;
    rdfs:comment "Links a measurement to an acclimation protocol applied before the measurement (via the acclimation_describe junction)."@en ;
    rdfs:domain vocab:Measurement ;
    rdfs:range vocab:Acclimation ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> .

# =============================================================================
# DATATYPE PROPERTIES
# =============================================================================

# ---------------------------------------------------------------------------
# Dataset properties
# ---------------------------------------------------------------------------

vocab:hasTitle a owl:DatatypeProperty ;
    rdfs:label "has title"@en ;
    rdfs:comment "Title of a dataset or manuscript."@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> .

vocab:hasDOI a owl:DatatypeProperty ;
    rdfs:label "has DOI"@en ;
    rdfs:comment "Digital Object Identifier (DOI) provided as a URL."@en ;
    rdfs:range xsd:anyURI ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> .

vocab:hasShareTraitDatasetID a owl:DatatypeProperty ;
    rdfs:label "has ShareTrait dataset ID"@en ;
    rdfs:comment "Reference identifier linking to the ShareTrait dataset (e.g., 'Alfaro_Tapia_et_al_2022')."@en ;
    rdfs:domain vocab:Dataset ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> .

vocab:hasReferenceType a owl:DatatypeProperty ;
    rdfs:label "has reference type"@en ;
    rdfs:comment "Indicates whether the reference is primary or secondary."@en ;
    rdfs:domain vocab:Dataset ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> .

vocab:hasDatasetType a owl:DatatypeProperty ;
    rdfs:label "has dataset type"@en ;
    rdfs:comment "Type of dataset (e.g., 'dataset')."@en ;
    rdfs:domain vocab:Dataset ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> .

vocab:hasPublisher a owl:DatatypeProperty ;
    rdfs:label "has publisher"@en ;
    rdfs:comment "Name of the publisher or repository (e.g., 'zenodo', 'figshare')."@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> .

vocab:hasYearPublication a owl:DatatypeProperty ;
    rdfs:label "has year of publication"@en ;
    rdfs:comment "Year of publication."@en ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> .

vocab:hasDateContribution a owl:DatatypeProperty ;
    rdfs:label "has date of contribution"@en ;
    rdfs:comment "Date when the dataset was contributed to ShareTrait."@en ;
    rdfs:domain vocab:Dataset ;
    rdfs:range xsd:date ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> .

vocab:hasDatasetTrait a owl:DatatypeProperty ;
    rdfs:label "has dataset trait"@en ;
    rdfs:comment "Reference trait term used for the dataset (e.g., 'development', 'metabolic_rate')."@en ;
    rdfs:domain vocab:Dataset ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> .

vocab:hasComment a owl:DatatypeProperty ;
    rdfs:label "has comment"@en ;
    rdfs:comment "Free-text remark or note."@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> .

vocab:hasCommentsReference a owl:DatatypeProperty ;
    rdfs:label "has comments reference"@en ;
    rdfs:comment "Notes about the reference, e.g., whether the dataset has been published."@en ;
    rdfs:domain vocab:Dataset ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> .

# ---------------------------------------------------------------------------
# Manuscript properties
# ---------------------------------------------------------------------------

vocab:hasType a owl:DatatypeProperty ;
    rdfs:label "has type"@en ;
    rdfs:comment "Type of manuscript (e.g., 'article', 'data paper')."@en ;
    rdfs:domain vocab:Manuscript ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> .

vocab:hasCitation a owl:DatatypeProperty ;
    rdfs:label "has citation"@en ;
    rdfs:comment "Full bibliographic citation string."@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> .

# ---------------------------------------------------------------------------
# Population properties
# ---------------------------------------------------------------------------

vocab:hasPopulationName a owl:DatatypeProperty ;
    rdfs:label "has population name"@en ;
    rdfs:comment "Reference name or identifier used for the population in the dataset."@en ;
    rdfs:domain vocab:Population ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> .

vocab:hasPopulationLabel a owl:DatatypeProperty ;
    rdfs:label "has population label"@en ;
    rdfs:comment "Defines whether the population provides individual-level measurements ('ind_measure') or population-level aggregates ('pop_measure')."@en ;
    rdfs:domain vocab:Population ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> .

vocab:hasPopulationDescription a owl:DatatypeProperty ;
    rdfs:label "has population description"@en ;
    rdfs:comment "Free-text characteristics of the population."@en ;
    rdfs:domain vocab:Population ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> .

vocab:hasSpeciesReported a owl:DatatypeProperty ;
    rdfs:label "has species reported"@en ;
    rdfs:comment "Species name as given in the original study."@en ;
    rdfs:domain vocab:Population ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> .

vocab:hasAuthority a owl:DatatypeProperty ;
    rdfs:label "has authority"@en ;
    rdfs:comment "Taxonomic authority (author and year) associated with the species name."@en ;
    rdfs:domain vocab:Population ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> .

vocab:hasPopulationFacts a owl:DatatypeProperty ;
    rdfs:label "has population facts"@en ;
    rdfs:comment "Relevant information specific to the population as mentioned by the author."@en ;
    rdfs:domain vocab:Population ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> .

vocab:hasComments a owl:DatatypeProperty ;
    rdfs:label "has comments"@en ;
    rdfs:comment "General remarks or comments."@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> .

# ---------------------------------------------------------------------------
# Individual properties
# ---------------------------------------------------------------------------

vocab:hasRepresentativeStage a owl:DatatypeProperty ;
    rdfs:label "has representative stage"@en ;
    rdfs:comment "Life stage at which the individual was observed (e.g., 'egg', 'larvae', 'adult')."@en ;
    rdfs:domain vocab:Individual ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> .

vocab:hasSex a owl:DatatypeProperty ;
    rdfs:label "has sex"@en ;
    rdfs:comment "Sex of the individual as indicated in the study (e.g., 'female', 'male')."@en ;
    rdfs:domain vocab:Individual ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> .

vocab:hasIndividualType a owl:DatatypeProperty ;
    rdfs:label "has individual type"@en ;
    rdfs:comment "Indicates whether the individual is a 'parent' or 'offspring', used to control parenthood relationships."@en ;
    rdfs:domain vocab:Individual ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> .

vocab:hasMatingMethod a owl:DatatypeProperty ;
    rdfs:label "has mating method"@en ;
    rdfs:comment "Indicates whether mating was allowed or not during the acclimation period."@en ;
    rdfs:domain vocab:Individual ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> .

vocab:hasMethodType a owl:DatatypeProperty ;
    rdfs:label "has method type"@en ;
    rdfs:comment "Method used to estimate fecundity (e.g., 'counting')."@en ;
    rdfs:domain vocab:Individual ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> .

vocab:hasStrategyOfProtection a owl:DatatypeProperty ;
    rdfs:label "has strategy of protection"@en ;
    rdfs:comment "Indicates whether eggs are protected or not after laying."@en ;
    rdfs:domain vocab:Individual ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> .

vocab:hasDescription a owl:DatatypeProperty ;
    rdfs:label "has description"@en ;
    rdfs:comment "Free-text description and remarks relevant to the individual."@en ;
    rdfs:domain vocab:Individual ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> .

vocab:hasParentSizeType a owl:DatatypeProperty ;
    rdfs:label "has parent size type"@en ;
    rdfs:comment "Type of size metric for the parent (e.g., 'fresh body mass')."@en ;
    rdfs:domain vocab:Individual ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> .

vocab:hasParentSizeUnits a owl:DatatypeProperty ;
    rdfs:label "has parent size units"@en ;
    rdfs:comment "Unit of measurement for the parent's size metric (e.g., 'millimeter')."@en ;
    rdfs:domain vocab:Individual ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> .

vocab:hasParentalSizeValue a owl:DatatypeProperty ;
    rdfs:label "has parental size value"@en ;
    rdfs:comment "Numeric size value of the parent individual when collected."@en ;
    rdfs:domain vocab:Individual ;
    rdfs:range xsd:decimal ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> .

vocab:hasParentAge a owl:DatatypeProperty ;
    rdfs:label "has parent age"@en ;
    rdfs:comment "Age of the parent individual."@en ;
    rdfs:domain vocab:Individual ;
    rdfs:range xsd:integer ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> .

vocab:hasParentAgeUnits a owl:DatatypeProperty ;
    rdfs:label "has parent age units"@en ;
    rdfs:comment "Units used to define the parent's age (e.g., 'year')."@en ;
    rdfs:domain vocab:Individual ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> .

vocab:hasOffspringDevelopmentalStage a owl:DatatypeProperty ;
    rdfs:label "has offspring developmental stage"@en ;
    rdfs:comment "Category for each developmental stage of the offspring (e.g., 'egg stage I')."@en ;
    rdfs:domain vocab:Individual ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> .

vocab:hasOffspringSizeType a owl:DatatypeProperty ;
    rdfs:label "has offspring size type"@en ;
    rdfs:comment "Type of size metric for the offspring (e.g., 'egg volume')."@en ;
    rdfs:domain vocab:Individual ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> .

vocab:hasOffspringSizeUnits a owl:DatatypeProperty ;
    rdfs:label "has offspring size units"@en ;
    rdfs:comment "Unit of the offspring size metric (e.g., 'milligram')."@en ;
    rdfs:domain vocab:Individual ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> .

vocab:hasOffspringSizeValue a owl:DatatypeProperty ;
    rdfs:label "has offspring size value"@en ;
    rdfs:comment "Numeric size value of the offspring."@en ;
    rdfs:domain vocab:Individual ;
    rdfs:range xsd:decimal ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> .

# ---------------------------------------------------------------------------
# Measurement properties
# ---------------------------------------------------------------------------

vocab:hasTraitType a owl:DatatypeProperty ;
    rdfs:label "has trait type"@en ;
    rdfs:comment "Generic type category for trait measurements (e.g., 'development', 'fecundity', 'metabolic_rate')."@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> .

vocab:hasTraitValue a owl:DatatypeProperty ;
    rdfs:label "has trait value"@en ;
    rdfs:comment "Measured numeric value of the trait."@en ;
    rdfs:domain vocab:Measurement ;
    rdfs:range xsd:decimal ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> .

vocab:hasTraitUnit a owl:DatatypeProperty ;
    rdfs:label "has trait unit"@en ;
    rdfs:comment "Unit of measurement for the trait value (e.g., 'mLO2/h/ind', 'offspring number', 'day')."@en ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> .

vocab:hasTraitErrorEstimate a owl:DatatypeProperty ;
    rdfs:label "has trait error estimate"@en ;
    rdfs:comment "Error value associated with the trait estimate."@en ;
    rdfs:domain vocab:Measurement ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> .

vocab:hasTraitErrorType a owl:DatatypeProperty ;
    rdfs:label "has trait error type"@en ;
    rdfs:comment "Type of error metric used (e.g., standard deviation, standard error)."@en ;
    rdfs:domain vocab:Measurement ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> .

vocab:hasTraitConverted a owl:DatatypeProperty ;
    rdfs:label "has trait converted"@en ;
    rdfs:comment "Trait measurement value that has been converted for standardisation and data integration purposes."@en ;
    rdfs:domain vocab:Measurement ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> .

vocab:hasIndividualDevelopmentalStage a owl:DatatypeProperty ;
    rdfs:label "has individual developmental stage"@en ;
    rdfs:comment "Developmental stage of the individual at time of measurement (specific for development trait)."@en ;
    rdfs:domain vocab:Measurement ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> .

vocab:hasFreshMass a owl:DatatypeProperty ;
    rdfs:label "has fresh mass"@en ;
    rdfs:comment "Fresh body mass of the individual at time of measurement."@en ;
    rdfs:domain vocab:Measurement ;
    rdfs:range xsd:decimal ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> .

vocab:hasFreshMassUnit a owl:DatatypeProperty ;
    rdfs:label "has fresh mass unit"@en ;
    rdfs:comment "Unit used for the fresh body mass measurement."@en ;
    rdfs:domain vocab:Measurement ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> .

vocab:hasSampleSize a owl:DatatypeProperty ;
    rdfs:label "has sample size"@en ;
    rdfs:comment "Number of individuals tested for the trait estimate."@en ;
    rdfs:domain vocab:Measurement ;
    rdfs:range xsd:string ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> .

vocab:hasSizeValue a owl:DatatypeProperty ;
    rdfs:label "has size value"@en ;
    rdfs:comment "Body size value of the individual at time of measurement."@en ;
    rdfs:domain vocab:Measurement ;
    rdfs:range xsd:decimal ;
    rdfs:isDefinedBy <https://sharetrait.org/vocab/> .

vocab:hasSizeUnits a owl:DatatypeProperty ;
